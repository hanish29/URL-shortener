<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR CODE</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>QR Code</h1>
    <h2>Scan QR code</h2>
    <img class="qr-img" src="<%= qr %>" alt="QR Code">

    <br><br>

    <a  href="/<%= url.code %>">
        <button class="qr-btn">Open Link</button>
    </a>

    <a href="/url.srt">
        <button class="qr-btn">Back</button>
    </a>
    
</body>
</html>